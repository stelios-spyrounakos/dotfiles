""" General options """""""""""""""""""""""""""""""""""""""""""""""""""""""""""
set nocompatible                        " Disable compatibility with vi

set encoding=utf-8

filetype on                             " Enable file type detection
filetype plugin on                      " Enable plugins and load plugin for the detected file type
filetype indent on                      " Load an indent file for the detected file type

set number                              " Enable line numbers
set cursorline                          " Highlight current line
set ruler                               " Display the current cursor position in the lower right corner
set colorcolumn=80                      " Show a vertical column
highlight ColorColumn ctermbg=236 guibg=#262626
set wrap                                " Enable line wrapping
set whichwrap=b,<,h,>,l,[,]             " Movements allowed to wrap ([, ] so that <, > works in insert mode)
set scrolloff=3                         " Offset from the window border when scrolling
"set nofoldenable                        " Disables folding

set expandtab                           " Use spaces instead of tabs
set tabstop=4
set shiftwidth=4
set autoindent                          " Use the indent of the previous line

syntax on                               " Enable syntax highlighting

set showmatch                           " Show matching parentheses
set showmode                            " Show the mode you are on the last line
set showcmd                             " Show partial command in the last line of the screen

set mouse=a                             " Enable mouse support

set listchars=tab:>-,trail:-            " Every tab will be displayed as ">--..." and trailing white space as "-".

set history=100                         " Number of commands and search patterns to keep in the history

set undofile                            " Saves undo history to an undo file when writing a buffer, and restores
                                        " undo history from the same file on buffer read

"set wildmenu                           " Enable auto completion menu after pressing TAB
"set wildmode=list:longest              " Make wildmenu behave similar to Bash completion
"set wildignore=*.docx,*.jpg,*.png,*.gif,*.pdf,*.pyc,*.exe,*.flv,*.img,*.xlsx

set conceallevel=1                      " Useful e.g. for Markdown or LaTeX syntax concealment

" Ensure vim starts a server (e.g. for inverse search functionality)
" (This will only work for a clientserver-enabled vim installation and is needed only for tui-vim)
if empty(v:servername) && exists('*remote_startserver')
  call remote_startserver('VIM')
endif

" VimTex configuration
let g:vimtex_view_method = 'zathura_simple'
let g:vimtex_complete_close_braces = 1      " Add a closing brace after completion

" Vim markdown configuration
let g:vim_markdown_no_extensions_in_markdown = 1    " Do not require .md extensions for Markdown links

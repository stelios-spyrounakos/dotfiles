" Colorschemes
Plug 'morhetz/gruvbox'
Plug 'catppuccin/nvim', { 'as': 'catppuccin' }

" VimTex for LaTeX
Plug 'lervag/vimtex', { 'tag': 'v2.16' }

" Markdown support and preview
Plug 'preservim/vim-markdown'
